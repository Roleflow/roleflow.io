    <div style="text-align:left;margin-top:12px"><div class="row"><span>Setup cost</span><b>$0</b></div><div class="row"><span>Monthly retainer</span><b>$0</b></div><div class="row"><span>Roleflow share</span><b id="fee"></b></div><div class="row"><span>You keep</span><b id="keep" style="color:var(--gold)"></b></div></div>
