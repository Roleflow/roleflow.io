<script>
const BOOKING_URL="https://calendar.app.google/8i1gomkozavqYU5b8";
const $=n=>'$'+Math.round(n).toLocaleString('en-US'),g=id=>document.getElementById(id);
const esc=s=>s.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* leak calculator */
function leak(){const d=+g('d').value,l=+g('l').value,v=+g('v').value;g('dv').textContent=d.toLocaleString();g('lv').textContent=l+'%';g('vv').textContent=$(v);g('lost').textContent=$(d*30*l/100*.05*v)}
['d','l','v'].forEach(i=>g(i).oninput=leak);leak();

/* voice note demo */
const W=g('wave');for(let i=0;i<30;i++){const b=document.createElement('i');b.style.height=(30+Math.abs(Math.sin(i*1.7)*60+Math.cos(i*.6)*20))+'%';W.appendChild(b)}
const TX='"Hey! Yes, I have two spots left this month. Want me to save one for you?"';let pt=null;
g('play').onclick=()=>{const bs=[...W.children],p=g('play');
  if(pt){clearInterval(pt);pt=null;bs.forEach(b=>b.classList.remove('on'));p.innerHTML='&#9654;';g('tm').textContent='0:07';return}
  let i=0;p.innerHTML='&#10074;&#10074;';g('tr').textContent=TX;
  pt=setInterval(()=>{i++;bs.forEach((b,k)=>b.classList.toggle('on',k<i));g('tm').textContent='0:0'+Math.max(0,7-Math.floor(i/bs.length*7));
    if(i>=bs.length){clearInterval(pt);pt=null;p.innerHTML='&#9654;';g('tm').textContent='0:07'}},230)};

/* commission calculator */
let rate=6;
g('seg').innerHTML=[5,6,7].map(r=>`<button data-r="${r}" aria-pressed="${r===rate}">${r}%</button>`).join('');
function pay(){const v=+g('rv').value;g('rvv').textContent=$(v);g('fee').textContent=$(v*rate/100);g('keep').textContent=$(v*(100-rate)/100)}
g('rv').oninput=pay;
g('seg').querySelectorAll('button').forEach(b=>b.onclick=()=>{rate=+b.dataset.r;g('seg').querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x===b));pay()});pay();

/* qualification quiz: click an answer and it moves on. 0 = fails qualification */
const CK=['20+ DMs a day','Offer above $1k','Close rate above 20%','$30k+ cash collected a month'];
const Q=[
{k:'dms',n:'over 20 DMs a day',q:'How many DMs do you get from potential customers per day?',o:[['20 or fewer',0],['21 to 50',1],['51 to 100',1],['More than 100',1]]},
{k:'offer',n:'an offer priced above $1k',q:'What is the price of your main offer?',o:[['$1,000 or less',0],['$1,001 to $3,000',1],['$3,001 to $10,000',1],['More than $10,000',1]]},
{k:'close',n:'a closing rate above 20%',q:'What is your closing rate on sales calls?',o:[['20% or lower',0],['21% to 30%',1],['31% to 50%',1],['More than 50%',1],["I don't track it yet",0]]},
{k:'cash',n:'over $30k a month in cash collected',q:'How much cash do you collect each month?',o:[['$30,000 or less',0],['$30,001 to $100,000',1],['$100,001 to $500,000',1],['More than $500,000',1]]}
];
const F=[['n','What should we call you?','text','name','Your first name'],['e','What email can we reach you on?','email','email','you@business.com'],['ig','What is your Instagram handle?','text','off','@yourbusiness']];
const A={},T=Q.length+F.length,qz=g('qz');let qi=0,keyH=null,first=true;
const prog=n=>`<div class="prog">${Array.from({length:T},(_,i)=>`<i class="${i<=n?'on':''}"></i>`).join('')}</div>`;
const wrap=(h,back)=>{qz.innerHTML=`<div class="screen${back?' back':''}">${h}</div>`};
function quiz(back){
  
  if(qi<Q.length){
    const q=Q[qi];
    wrap(`${prog(qi)}<h3 style="font-size:1.5rem">${q.q}</h3><div class="opts">${q.o.map((o,j)=>`<button class="opt${A[q.k]&&A[q.k][0]===j?' sel':''}" data-j="${j}"><kbd>${j+1}</kbd>${o[0]}</button>`).join('')}</div>
    <div class="nav"><button class="btn ghost sm" id="bk" ${qi?'':'disabled'}>Back</button><span class="mute">${qi+1} of ${T}</span></div>`,back);
    const pick=j=>{A[q.k]=[j,q.o[j][0],q.o[j][1]];qz.querySelectorAll('.opt')[j].classList.add('sel');setTimeout(()=>{qi++;quiz()},260)};
    qz.querySelectorAll('.opt').forEach(b=>b.onclick=()=>pick(+b.dataset.j));
    keyH=e=>{const j=+e.key-1;if(j>=0&&j<q.o.length)pick(j)};
    g('bk').onclick=()=>{qi--;quiz(1)};
  }else if(qi<T){
    const f=F[qi-Q.length];keyH=null;
    wrap(`${prog(qi)}<h3 style="font-size:1.5rem">${f[1]}</h3><input class="fin" id="fi" type="${f[2]}" autocomplete="${f[3]}" placeholder="${f[4]}" value="${esc(A[f[0]]||'')}"><p class="err" id="er"></p>
    <div class="nav"><button class="btn ghost sm" id="bk">Back</button><button class="btn" id="nx">${qi===T-1?'See my result':'Continue'}</button></div>`,back);
    const fi=g('fi');fi.focus({preventScroll:true});
    const next=()=>{const v=fi.value.trim();if(f[0]==='e'?!/^\S+@\S+\.\S+$/.test(v):!v){g('er').textContent=f[0]==='e'?'Enter a valid email address.':'This field is required.';return}A[f[0]]=v;qi++;quiz()};
    fi.onkeydown=e=>{if(e.key==='Enter')next()};g('nx').onclick=next;g('bk').onclick=()=>{qi--;quiz(1)};
  }else{keyH=null;analyze()}
}
qz.addEventListener('keydown',e=>{if(keyH&&e.target.tagName!=='INPUT')keyH(e)});
function analyze(){
  const m=['Checking your offer','Matching deal value to volume','Reviewing commission fit'];let k=0;
  wrap(`<div class="result"><div class="spin"></div><h3 id="am">${m[0]}</h3></div>`);
  const iv=setInterval(()=>{k++;if(g('am')&&k<m.length)g('am').textContent=m[k]},600);
  setTimeout(()=>{clearInterval(iv);result()},1900);
}
function result(){
  const fails=Q.filter(q=>A[q.k][2]===0),ok=!fails.length,nm=esc(A.n.split(' ')[0]);
  // TODO: send {name:A.n,email:A.e,instagram:A.ig,answers:A,qualified:ok} to your form backend / CRM here
  const recap='<ul class="recap">'+Q.map(q=>`<li>${esc(A[q.k][1])}</li>`).join('')+'</ul>';
  wrap(ok?`<div class="result"><div class="tick">&#10003;</div><h2 style="font-size:2rem">You qualify, ${nm}.</h2><p>Your business is a strong fit for a commission-based DM system that replies in your own voice. Taking you to book your call now. If nothing happens, use the button.</p>${recap}<a class="btn" id="bookbtn" href="${BOOKING_URL}" target="_blank" rel="noopener">Book your call</a></div>`:
  `<div class="result"><h2 style="font-size:2rem">Not a fit yet, ${nm}.</h2><p>Because we're paid from the revenue your DMs generate, we can't take on your business right now. To work with us you need over 20 DMs a day, an offer above $1k, a closing rate above 20% and over $30k a month in cash collected. Right now you're missing: ${fails.map(f=>f.n).join(', ')}.</p><button class="btn ghost" id="again">Retake the quiz</button></div>`);
  if(ok)setTimeout(()=>{if(g('bookbtn')){try{window.top.location.href=BOOKING_URL}catch(e){}}},2500);
  const a=g('again');if(a)a.onclick=()=>{for(const k in A)delete A[k];qi=0;quiz()};
}
quiz();
</script>
</body>
