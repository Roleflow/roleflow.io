<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Roleflow: Stop losing $50K/mo on slow replies</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#0A1226;--bg2:#101A33;--line:#243155;--ink:#EEF1FA;--mute:#9AA6C6;--gold:#E8B04A;--m:#C0409A;--o:#FF8A3D;--grad:linear-gradient(120deg,#7B4DFF,#C0409A 50%,#FF8A3D);
--h:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;--b:'Instrument Sans','Segoe UI',system-ui,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{color-scheme:dark;scroll-behavior:smooth;scroll-padding-top:calc(76px + env(safe-area-inset-top,0px))}
body{margin:0;background:radial-gradient(900px 520px at 50% -8%,rgba(123,77,255,.28),transparent 62%),radial-gradient(700px 420px at 100% 40%,rgba(255,138,61,.09),transparent 60%),var(--bg);color:var(--ink);font:400 17px/1.55 var(--b);text-align:center}
h1,h2,h3{font-family:var(--h);line-height:1.05;margin:0;letter-spacing:-.02em}
h1{font-size:clamp(2.5rem,8.2vw,5.6rem);font-weight:800;text-transform:uppercase;letter-spacing:-.03em}
h2{font-size:clamp(1.8rem,4.6vw,3rem);font-weight:800}
h3{font-size:1.15rem;font-weight:700}
p{margin:0}.mute{color:var(--mute)}
.g{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
:focus-visible{outline:2px solid var(--o);outline-offset:3px}
.wrap{max-width:900px;margin:0 auto;padding:0 22px}
section{padding:92px 0}
.sub{color:var(--mute);max-width:36em;margin:16px auto 0;font-size:1.08rem}
nav{position:sticky;top:0;z-index:5;background:rgba(10,18,38,.82);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0px)}
nav .in{max-width:1080px;margin:0 auto;padding:12px 22px;display:flex;align-items:center;justify-content:center}
.brand{display:flex;align-items:center;gap:10px;font:800 1.2rem var(--h)}
.brand img{width:34px;height:34px;border-radius:50%}
.btn{display:inline-block;border:0;cursor:pointer;font:600 1.02rem var(--b);color:#fff;background:var(--grad);padding:15px 30px;border-radius:999px;transition:transform .15s,box-shadow .15s;text-decoration:none}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(192,64,154,.45)}
.btn.ghost{background:none;border:1px solid var(--line);color:var(--ink)}
.btn.ghost:hover{box-shadow:none;border-color:var(--o)}
.btn.sm{padding:9px 20px;font-size:.92rem}
.btn[disabled]{opacity:.35;pointer-events:none}
.hero{padding:56px 0 40px}.hero .panel{margin-top:34px}
.hero .sub{font-size:1.2rem;max-width:34em;margin:26px auto 34px}
.pills{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:28px}
.pill{border:1px solid var(--line);background:var(--bg2);border-radius:999px;padding:7px 16px;font-size:.9rem;color:var(--mute)}
.checks{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:26px}
.ck{border:1px solid var(--line);border-radius:12px;padding:10px 8px;font-size:.8rem;color:var(--mute);line-height:1.25;transition:.3s}
.ck i{display:block;font-style:normal;font-size:1.1rem;margin-bottom:2px}
.ck.ok{border-color:var(--gold);color:var(--ink);background:rgba(232,176,74,.1)}
.ck.no{border-color:var(--o);color:var(--ink);background:rgba(255,138,61,.1)}
.panel{background:var(--bg2);border:1px solid var(--line);border-radius:26px;padding:34px;max-width:700px;margin:38px auto 0}

/* leak calc */
.sl{text-align:left;margin:18px 0}
.sl label{display:flex;justify-content:space-between;color:var(--mute);font-size:.95rem}
.sl b{color:var(--ink)}
input[type=range]{width:100%;accent-color:var(--m);margin:8px 0 0}
.lost{margin-top:24px;padding-top:22px;border-top:1px solid var(--line)}
.big{font:800 clamp(2.4rem,7vw,4rem) var(--h);color:var(--gold);line-height:1}

/* voice demo */
.dm{background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:18px;max-width:400px;margin:38px auto 0;display:flex;flex-direction:column;gap:10px;text-align:left}
.dm .top{display:flex;align-items:center;gap:10px;font-weight:600;font-size:.92rem;padding-bottom:10px;border-bottom:1px solid var(--line)}
.dot{width:30px;height:30px;border-radius:50%;background:var(--grad)}
.bub{max-width:88%;padding:10px 14px;border-radius:17px;font-size:.95rem;line-height:1.4}
.bub.them{background:#1D2848;align-self:flex-start;border-bottom-left-radius:4px}
.bub.us{background:linear-gradient(120deg,#6A45E0,#B03F9F);align-self:flex-end;border-bottom-right-radius:4px;display:flex;align-items:center;gap:10px;min-width:240px}
.play{flex:none;width:34px;height:34px;border-radius:50%;border:0;background:#fff;color:#7B2FB5;cursor:pointer;font-size:.8rem}
.wave{display:flex;align-items:center;gap:2px;height:30px;flex:1}
.wave i{flex:1;background:rgba(255,255,255,.4);border-radius:2px;transition:background .15s}
.wave i.on{background:#fff}
.tm{font-size:.78rem;opacity:.85;min-width:2.4em}
.tr{font-size:.85rem;color:var(--mute);align-self:flex-end;max-width:88%;font-style:italic;min-height:2.8em}
.tag{align-self:center;font-size:.8rem;color:var(--gold);border:1px solid var(--gold);background:rgba(232,176,74,.1);border-radius:999px;padding:3px 12px}
.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:44px}
.trio div{background:var(--bg2);border:1px solid var(--line);border-radius:18px;padding:22px 18px}
.trio p{color:var(--mute);font-size:.95rem;margin-top:6px}

/* before/after */
.vs{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:40px;text-align:left}
.vs>div{border:1px solid var(--line);border-radius:22px;padding:26px;background:var(--bg2)}
.vs .w{border-color:var(--m);background:rgba(192,64,154,.09)}
.vs ul{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:10px;color:var(--mute)}
.vs li::before{content:"\2715  ";color:#7E8AAE}.vs .w li::before{content:"\2713  ";color:var(--gold)}.vs .w li{color:var(--ink)}

/* pay */
.seg{display:flex;gap:8px;max-width:300px;margin:0 auto}
.seg button{flex:1;background:var(--bg);border:1px solid var(--line);color:var(--ink);border-radius:12px;padding:11px;font:700 1rem var(--b);cursor:pointer}
.seg button[aria-pressed=true]{border-color:var(--m);background:rgba(192,64,154,.18)}
.row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line)}
.row:last-child{border:0}

/* quiz */
#quiz .checks{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:26px}
.ck{border:1px solid var(--line);border-radius:12px;padding:10px 8px;font-size:.8rem;color:var(--mute);line-height:1.25;transition:.3s}
.ck i{display:block;font-style:normal;font-size:1.1rem;margin-bottom:2px}
.ck.ok{border-color:var(--gold);color:var(--ink);background:rgba(232,176,74,.1)}
.ck.no{border-color:var(--o);color:var(--ink);background:rgba(255,138,61,.1)}
.panel{background:var(--bg2);text-align:center;padding:34px 30px}
.prog{display:flex;gap:6px;margin-bottom:28px}
.prog i{flex:1;height:5px;border-radius:9px;background:var(--line);transition:.3s}
.prog i.on{background:var(--grad)}
.screen{animation:inR .35s cubic-bezier(.2,.8,.2,1)}.screen.back{animation-name:inL}
@keyframes inR{from{opacity:0;transform:translateX(34px)}to{opacity:1;transform:none}}
@keyframes inL{from{opacity:0;transform:translateX(-34px)}to{opacity:1;transform:none}}
.opts{display:grid;gap:10px;margin-top:24px}
.opt{display:flex;align-items:center;gap:14px;text-align:left;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:16px;padding:16px 18px;font:500 1.02rem var(--b);cursor:pointer;transition:.15s}
.opt:hover{border-color:var(--o);transform:translateX(4px)}
.opt kbd{font:600 .8rem var(--b);border:1px solid var(--line);border-radius:6px;padding:1px 7px;color:var(--mute)}
.opt.sel{border-color:var(--m);background:rgba(192,64,154,.22)}
.fin{width:100%;background:transparent;border:0;border-bottom:2px solid var(--line);color:var(--ink);font:600 clamp(1.3rem,4vw,1.9rem) var(--h);padding:14px 0;margin-top:22px;text-align:center}
.fin:focus{outline:0;border-color:var(--m)}
.err{color:var(--o);min-height:1.5em;margin-top:10px;font-size:.95rem}
.nav{display:flex;justify-content:space-between;align-items:center;margin-top:26px}
.spin{width:60px;height:60px;border-radius:50%;margin:10px auto 22px;border:4px solid var(--line);border-top-color:var(--o);border-right-color:var(--m);animation:sp 1s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.result p{margin:14px auto 22px;max-width:30em;color:var(--mute)}
.tick{width:70px;height:70px;border-radius:50%;background:var(--grad);display:grid;place-items:center;font-size:2rem;margin:0 auto 18px}
.recap{list-style:none;padding:0;margin:0 0 22px;color:var(--mute);font-size:.95rem}
details{border-bottom:1px solid var(--line);padding:18px 0;text-align:left}
summary{cursor:pointer;font:600 1.1rem var(--h)}
details p{color:var(--mute);margin-top:10px}
footer{padding:40px 22px 60px;color:var(--mute);font-size:.9rem;border-top:1px solid var(--line)}
@media(max-width:760px){.checks{grid-template-columns:1fr 1fr}.trio,.vs{grid-template-columns:1fr}section{padding:64px 0}.panel{padding:26px 18px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<nav><div class="in"><div class="brand"><img alt="" src="data:image/jpeg;base64,">Roleflow</div></div></nav>

<header class="hero" id="top"><div class="wrap">
