{
  "redirects": [
    {
      "source": "/admin/office",
      "destination": "/admin/hq/",
      "statusCode": 301
    },
    {
      "source": "/admin/office/",
      "destination": "/admin/hq/",
      "statusCode": 301
    },
    {
      "source": "/admin/office/index.html",
      "destination": "/admin/hq/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "roleflow.io"
        }
      ],
      "destination": "https://www.roleflow.io/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://share.descript.com"
        }
      ]
    },
    {
      "source": "/(account|admin|reset)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
